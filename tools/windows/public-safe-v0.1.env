# Jiuguan v0.1 public distribution profile.
# All autonomous lanes and all model-backed maintenance are disabled by default.
JG_AGENT_RUNTIME_PROFILE=public-safe-v0.1
JG_AGENT_LANE_ROLLOUT=interactive=off,learning=off,maintenance=off
JG_AGENT_LANE_ROLLOUT_ACK=p14-lane-rollout-v2
JG_AGENT_CONTROL_MUTATION=off
JG_AGENT_CONTROL_MUTATION_ACK=p14-agent-control-mutation-v1
JG_AGENT_ADMISSION=off
JG_AGENT_ADMISSION_ACK=p14-quality-beta-v1
JG_AGENT_ADMISSION_SESSION_ALLOWLIST=disabled
JG_AGENT_LEARNING_TEXT=off
JG_AGENT_LEARNING_TEXT_ACK=p14-learning-text-provider-v1
JG_HARNESS_INTERACTIVE=off
JG_HARNESS_INTERACTIVE_ACK=p13c-v1
JG_HARNESS_BACKGROUND=off
JG_HARNESS_INPUT_MICROUSD_PER_MTOK=50000000
JG_HARNESS_OUTPUT_MICROUSD_PER_MTOK=50000000
JG_CONTEXT_COMPILER=off
JG_CONTEXT_COMPILER_ACK=p14-q9r-context-compiler-v1
JG_CONTEXT_COMPILER_SESSION_IDS=disabled
JG_CONTEXT_COMPILER_KILL_SWITCH=1
JG_MAINTENANCE_ADMISSION=off
JG_MAINTENANCE_ADMISSION_ACK=p14-maintenance-enforce-v2
JG_MAINTENANCE_ADMISSION_SESSION_ALLOWLIST=disabled
JG_MAINTENANCE_APPLY=off
JG_MAINTENANCE_APPLY_ACK=p14-maintenance-apply-v1
JG_MAINTENANCE_APPLY_SESSION_ALLOWLIST=disabled

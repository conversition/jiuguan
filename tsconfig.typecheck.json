{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "plugins/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "review-package-*/**",
    "**/dist/**",
    "**/tests/**",
    "tools/**/verify-*.ts"
  ]
}
